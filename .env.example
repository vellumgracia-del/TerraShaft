# ==============================================================================
# TerraShaft - Environment Configuration Template (.env.example)
# Public repository safe placeholder file - DO NOT COMMIT REAL SECRETS
# ==============================================================================

# TerraShaft runtime data mode
# Allowed values: api | demo
# api: Attempts requests to official NASA POWER and ISRIC SoilGrids proxy APIs
# demo: Runs in explicit demo simulation mode with simulated agroclimatic data
NEXT_PUBLIC_DATA_MODE=api

# Optional preview toggle during initial loading transitions
NEXT_PUBLIC_ENABLE_DEMO_PREVIEW=false

# NASA POWER API Base URL
# The public NASA POWER agroclimatology REST endpoint does not require an API key.
NASA_POWER_API_BASE_URL=https://power.larc.nasa.gov/api

# ISRIC SoilGrids REST API Base URL
# The public ISRIC SoilGrids v2.0 endpoint does not require an API key.
ISRIC_SOILGRIDS_API_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# Upstream proxy request timeouts (in milliseconds)
NASA_POWER_TIMEOUT_MS=8000
ISRIC_SOILGRIDS_TIMEOUT_MS=8000

# Application presentation metadata
NEXT_PUBLIC_APP_NAME=TerraShaft
NEXT_PUBLIC_DEFAULT_LOCATION=Kupang Timur
